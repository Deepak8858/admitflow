# Copy to .env.local for development. Keep real values outside source control and Docker contexts.
# The production containers receive server secrets from the existing Secrets Manager JSON secret.
# Use Node 24. See docs/deployment.md and infra/application-secret.example.json.

# Application origin: must match browser origin, WorkOS redirects and provider callbacks.
APP_BASE_URL=http://127.0.0.1:3000
# With DATABASE_URL empty, development uses the local SQLite aggregate only.
ADMITFLOW_DB=.data/admitflow.sqlite

# Neon PostgreSQL, preferably Singapore (aws-ap-southeast-1).
# Runtime: pooled endpoint and a non-owner, non-BYPASSRLS application role.
# Example shape only: postgresql://ROLE:PASSWORD@ep-EXAMPLE-pooler.ap-southeast-1.aws.neon.tech/admitflow?sslmode=verify-full
DATABASE_URL=
DATABASE_POOL_SIZE=8
# Schema/SQLite migrations ONLY: direct endpoint and the separate migration role.
# Example shape only: postgresql://ROLE:PASSWORD@ep-EXAMPLE.ap-southeast-1.aws.neon.tech/admitflow?sslmode=verify-full
DATABASE_URL_UNPOOLED=

# WorkOS AuthKit. Cookie password must be a strong random value of at least 32 characters.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=client_01M2AYVZKZDVYS78WFQ0XT8K78
WORKOS_COOKIE_PASSWORD=
# Public and build-time in Next. Register this exact callback in WorkOS.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://127.0.0.1:3000/callback
# Optional signed WorkOS event integration; include an empty JSON key until its handler is enabled.
WORKOS_WEBHOOK_SECRET=
# AuthKit normally uses host-only cookies; leave optional overrides unset.
# WORKOS_COOKIE_DOMAIN=
# WORKOS_COOKIE_SAMESITE=lax

# Private Cloudflare R2 bucket. These are R2-scoped API credentials, NOT AWS IAM credentials.
# Endpoint is derived as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com, SDK region 'auto'.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AWS region and tenant credential encryption. ECS uses task roles; never put AWS access keys here.
AWS_REGION=ap-southeast-1
# CDK injects its retained, rotation-enabled key ARN. Encryption context includes organizationId.
KMS_KEY_ID=
# Local development only, if KMS is unavailable: base64 encoding of exactly 32 random bytes.
# This is not copied into production. Existing local ciphertext needs a reviewed rekey migration.
INTEGRATION_ENCRYPTION_KEY=
# Required for hosted intake/cleanup. JSON array of 1–4 distinct base64 32-byte keys.
# First key is active; retain historical keys while any receipt references their version.
INTAKE_CONTACT_KEYS=

# BullMQ: local Node worker accepts REDIS_URL. Production uses private TLS Valkey + AUTH.
REDIS_URL=
# ECS sets these instead of storing a password-bearing URL in its task definition.
# infra/entrypoint.mjs assembles REDIS_URL in memory and forwards SIGTERM to the worker.
REDIS_HOST=
REDIS_PORT=6379
REDIS_TLS=true
REDIS_PASSWORD=
# Optional authenticated outbox dispatch endpoint, POST /api/jobs; continuous ECS worker is primary.
# Leave empty to disable that HTTP fallback.
CRON_SECRET=

# Meta WhatsApp Cloud API with WhatsApp Business-app coexistence.
# Both IDs are public and must be passed to docker build for the web target.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
# Server-side alias used by Meta Lead Ads verification; keep equal to NEXT_PUBLIC_META_APP_ID.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=
# Optional separate verify token for /api/webhooks/meta-leads; falls back to the token above.
META_LEADS_WEBHOOK_VERIFY_TOKEN=
# Per-institute access tokens, WABA/phone IDs and Page credentials are saved through Connections,
# encrypted with KMS in Neon. No platform-wide WhatsApp sender/token is used.
# Coexistence still requires the correct Meta Embedded Signup configuration and account eligibility.

# OpenAI: optional platform-managed fallback; institute-supplied keys are tenant-encrypted.
OPENAI_API_KEY=
# Optional pgvector indexing/retrieval, after its reviewed migration is installed. Full-text is default.
KNOWLEDGE_VECTOR_ENABLED=false
# Model, budgets, language, instructions and assisted/autonomous mode live in institute AI settings.
# OPENAI_MODEL is not read by the current provider implementation.

# ElevenLabs speech only: transcription and optional generated voice-note replies.
# WhatsApp transport remains Meta. Per-institute credentials/voice settings can override these.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Calendar OAuth. Callback: <APP_BASE_URL>/api/integrations/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional dedicated state signing secret (at least 32 characters); falls back to WorkOS cookie key.
GOOGLE_OAUTH_STATE_SECRET=
# Calendar IDs/refresh tokens are tenant connections, not shared environment variables.

# AdmitFlow SaaS billing merchant, separate from each institute's admission-fee merchant.
BILLING_RAZORPAY_KEY_ID=
BILLING_RAZORPAY_KEY_SECRET=
BILLING_RAZORPAY_WEBHOOK_SECRET=
BILLING_RAZORPAY_ACCOUNT_ID=
# JSON array of approved existing plans; no product prices are hardcoded here.
# Shape: [{"id":"your-plan","name":"Your plan","razorpayPlanId":"plan_REAL_ID","totalCount":12}]
BILLING_PLANS_JSON=[]
# Admission-fee Razorpay credentials and webhook secrets are stored per institute in Connections.

# Planned notification/observability integrations; not consumed by the current runtime or CDK secret map.
# Add SDK/config wiring and ECS secret selectors together when enabling them.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# SENTRY_DSN=

# Container-only values are supplied by Docker/CDK; normal local development does not set these.
# ADMITFLOW_PROCESS_ROLE=web|worker|migration
# HOSTNAME=0.0.0.0
# PORT=3000
# NEXT_TELEMETRY_DISABLED=1
# Recheck new provider variables in source when landing concurrent backend/service changes.
