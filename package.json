{
  "name": "admitflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:services": "node infra/build.mjs",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:infra": "tsx --test infra/tests/*.test.ts",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs --all",
    "verify:payments": "node scripts/verify.mjs --payments",
    "verify:browser": "node scripts/verify.mjs --browser",
    "preflight": "tsx scripts/preflight.ts",
    "payments:inspect": "tsx scripts/payments.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:import-sqlite": "tsx scripts/migrate-sqlite.ts",
    "worker": "tsx scripts/worker.ts",
    "infra:synth": "cdk synth --app \"npx tsx infra/app.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1131.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@fontsource-variable/geist": "latest",
    "@fontsource-variable/space-grotesk": "latest",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "@workos-inc/authkit-nextjs": "^4.3.1",
    "@workos-inc/node": "^10.13.0",
    "bullmq": "^5.81.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.4.0",
    "ioredis": "^5.11.1",
    "lucide-react": "latest",
    "next": "16.3.5",
    "openai": "^7.15.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "aws-cdk": "^2.1141.0",
    "aws-cdk-lib": "^2.269.0",
    "constructs": "^10.8.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "tsx": "latest",
    "typescript": "^5.9.0"
  }
}
